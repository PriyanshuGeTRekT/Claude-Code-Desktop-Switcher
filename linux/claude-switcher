class Updater:
    """Releases publish claude-switcher next to SHA256SUMS.txt. An update installs it
    only when it matches the published checksum, compiles, and is newer, and only over a
    copy the user can write (a .deb install is updated with the new .deb instead)."""

    ASSET = "claude-switcher"
    LOG = STATE_DIR / "update.log"

    @staticmethod
    def feed():
        d = os.environ.get("CLAUDE_SWITCHER_RELEASE_DIR", "")
        return Path(d) if d else None

    @staticmethod
    def compare(a, b):
        def parts(v):
            head = re.match(r"[0-9.]*", v).group(0)
            return [int(x) if x.isdigit() else 0 for x in head.split(".") if x != ""]
        pa, pb = parts(a), parts(b)
        for i in range(max(len(pa), len(pb))):
            x = pa[i] if i < len(pa) else 0
            y = pb[i] if i < len(pb) else 0
            if x != y:
                return -1 if x < y else 1
        return 0

    @staticmethod
    def _open(url, method="GET", timeout=60):
        req = urllib.request.Request(url, method=method, headers={"User-Agent": "ClaudeProfileSwitcher/%s (Linux)" % VERSION})
        return urllib.request.urlopen(req, timeout=timeout)

    @staticmethod
    def latest_version():
        f = Updater.feed()
        if f:
            return (f / "latest-version").read_text(encoding="utf-8").strip()
        with Updater._open("https://github.com/%s/releases/latest" % REPO, "HEAD", 30) as r:
            final = r.geturl()
        m = re.search(r"/releases/tag/v([^/?#]+)$", final)
        if not m:
            raise SwitcherError("Could not tell the latest version from %s." % final)
        return m.group(1)

    @staticmethod
    def download(name):
        f = Updater.feed()
        if f:
            return (f / name).read_bytes()
        with Updater._open("https://github.com/%s/releases/latest/download/%s" % (REPO, name), timeout=120) as r:
            return r.read()

    @staticmethod
    def published_hash(sums, name):
        for line in sums.splitlines():
            m = re.match(r"^\s*([0-9a-fA-F]{64})\s+\*?(.+?)\s*$", line)
            if m and m.group(2) == name:
                return m.group(1).lower()
        return None

    @staticmethod
    def check():
        try:
            Settings.set("LastUpdateCheck", now_iso())
        except OSError:
            pass
        v = Updater.latest_version()
        return v if Updater.compare(v, VERSION) > 0 else None

    @staticmethod
    def is_due():
        if Settings.get("UpdateCheck") is False:
            return False
        last = Settings.get("LastUpdateCheck")
        try:
            t = datetime.strptime(last, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
            return (datetime.now(timezone.utc) - t).total_seconds() > 24 * 3600
        except (TypeError, ValueError):
            return True

    @staticmethod
    def install():
        target = switcher_command()
        if not os.access(target, os.W_OK) or not os.access(os.path.dirname(target), os.W_OK):
            raise SwitcherError("%s belongs to the system (a .deb install). Install the new "
                                "claude-profile-switcher .deb from https://github.com/%s/releases/latest instead." % (target, REPO))
        if not Updater.check():
            return None
        sums = Updater.download("SHA256SUMS.txt").decode("utf-8", "replace")
        expected = Updater.published_hash(sums, Updater.ASSET)
        if not expected:
            raise SwitcherError("The release has no checksum for %s, so nothing was changed." % Updater.ASSET)
        data = Updater.download(Updater.ASSET)
        if hashlib.sha256(data).hexdigest() != expected:
            raise SwitcherError("The download does not match the published checksum, so nothing was changed.")
        m = re.search(rb'^VERSION = "([^"]+)"', data, re.M)
        if not m:
            raise SwitcherError("The download is not the switcher, so nothing was changed.")
        new_version = m.group(1).decode()
        if Updater.compare(new_version, VERSION) <= 0:
            raise SwitcherError("The download is version %s, not newer than %s. Nothing was changed." % (new_version, VERSION))
        try:
            compile(data, Updater.ASSET, "exec")
        except SyntaxError as e:
            raise SwitcherError("The download does not compile (%s), so nothing was changed." % e)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target), prefix=".claude-switcher-")
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.chmod(tmp, 0o755)
        os.replace(tmp, target)
        append_line(Updater.LOG, "Updated from %s to %s." % (VERSION, new_version))
        return new_version


