def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def append_line(path, message):
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        if path.exists() and path.stat().st_size > 100_000:
            path.unlink()
        with open(path, "a", encoding="utf-8") as f:
            f.write("[%s] %s\n" % (now_iso(), message))
    except OSError:
        pass


def switcher_command():
    """How .desktop files and helpers start this program again."""
    return os.path.realpath(sys.argv[0])


# ------------------------------------------------- settings.json (same keys everywhere) --

class Settings:
    @staticmethod
    def load():
        try:
            with open(SETTINGS_FILE, encoding="utf-8") as f:
                d = json.load(f)
            return d if isinstance(d, dict) else {}
        except (OSError, ValueError):
            return {}

    @staticmethod
    def save(d):
        PROFILE_ROOT.mkdir(parents=True, exist_ok=True)
        tmp = SETTINGS_FILE.with_suffix(".tmp")
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(d, f, indent=2, sort_keys=True)
        os.replace(tmp, SETTINGS_FILE)

    @staticmethod
    def get(key, default=None):
        return Settings.load().get(key, default)

    @staticmethod
    def map(key):
        v = Settings.load().get(key)
        return v if isinstance(v, dict) else {}

    @staticmethod
    def set(key, value):
        d = Settings.load()
        if value is None:
            d.pop(key, None)
        else:
            d[key] = value
        Settings.save(d)

    @staticmethod
    def set_entry(key, pid, value):
        d = Settings.load()
        m = d.get(key) if isinstance(d.get(key), dict) else {}
        if value is None:
            m.pop(pid, None)
        else:
            m[pid] = value
        d[key] = m
        Settings.save(d)


# ----------------------------------------------------------------------- finding Claude --

COMMANDS = ["claude-desktop", "claude-desktop-unofficial"]
KNOWN_PATHS = [
    "/usr/bin/claude-desktop", "/usr/local/bin/claude-desktop", "/opt/Claude/claude-desktop",
    "/usr/lib/claude-desktop/claude-desktop", "/opt/claude-desktop/claude-desktop",
    "/usr/bin/claude-desktop-unofficial", "/usr/lib/claude-desktop-unofficial/claude-desktop",
]
# Names the main Claude process can carry. Never "claude": that is Claude Code's CLI.
PROCESS_NAMES = {"claude-desktop", "claude-desktop-unofficial", "Claude", "claude-desktop-bin"}


def find_claude():
    override = os.environ.get("CLAUDE_SWITCHER_APP", "")
    if override:
        return override if os.access(override, os.X_OK) else None
    saved = Settings.get("ClaudePath")
    if isinstance(saved, str) and os.access(saved, os.X_OK):
        return saved
    for c in COMMANDS:
        found = shutil.which(c)
        if found:
            return found
    for p in KNOWN_PATHS:
        if os.access(p, os.X_OK):
            return p
    return None


def require_claude():
    app = find_claude()
    if not app:
        raise SwitcherError(
            "Claude for Linux was not found. Install Anthropic's claude-desktop package "
            "(https://claude.com/download), or point the switcher at it with --claude-path PATH.")
    return app


def claude_version(app):
    for cmd in (["dpkg-query", "-W", "-f=${Version}", "claude-desktop"],
                ["dpkg-query", "-W", "-f=${Version}", "claude-desktop-unofficial"],
                ["rpm", "-q", "--qf", "%{VERSION}", "claude-desktop"]):
        if shutil.which(cmd[0]):
            try:
                out = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
                if out.returncode == 0 and out.stdout.strip():
                    return out.stdout.strip()
            except (OSError, subprocess.SubprocessError):
                pass
    return "unknown version"


# ----------------------------------------------------------------------------- profiles --

class Profile:
    def __init__(self, pid_, name, data_dir, pid=None):
        self.id = pid_
        self.name = name
        self.data_dir = Path(data_dir)
        self.pid = pid

    @property
    def is_default(self):
        return self.id == DEFAULT_ID

    @property
    def wm_class(self):
        """Its own window class, so the taskbar keeps each account apart and pins it to
        its own launcher. The original account keeps Claude's own."""
        return None if self.is_default else "ClaudeProfile-" + slug(self.id)


def slug(text):
    s = re.sub(r"[^A-Za-z0-9]+", "-", text).strip("-").lower()
    return s or "account"


def profile_dir(pid_):
    return DEFAULT_DATA if pid_ == DEFAULT_ID else PROFILE_ROOT / pid_


def profile_ids():
    ids = [DEFAULT_ID]
    try:
        dirs = [p.name for p in PROFILE_ROOT.iterdir() if p.is_dir() and not p.name.startswith(".")]
    except OSError:
        dirs = []
    natural = lambda s: [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", s)]
    return ids + sorted(dirs, key=natural)


def list_profiles(status=True):
    labels = {k: v for k, v in Settings.map("Labels").items() if isinstance(v, str)}
    ids = profile_ids()
    running = running_map(ids) if status else {}
    return [Profile(i, labels.get(i, i), profile_dir(i), running.get(i)) for i in ids]


def resolve(name, status=True):
    allp = list_profiles(status)
    for test in (lambda p: p.id == name, lambda p: p.name == name, lambda p: p.name.lower() == name.lower()):
        for p in allp:
            if test(p):
                return p
    return None


def resolve_or_throw(name):
    p = resolve(name)
    if p:
        return p
    known = ", ".join(p.name for p in list_profiles(False))
    raise SwitcherError("There is no Claude profile called '%s'. Profiles: %s" % (name, known))


def validate_name(raw, except_id):
    name = raw.strip()
    if not name:
        return "Name cannot be empty."
    if len(name) > 40:
        return "Name is too long (40 characters max)."
    if name.startswith(".") or "/" in name or ":" in name or "\0" in name:
        return "Name cannot start with a dot or contain / or :."
    for p in list_profiles(False):
        if p.id != except_id and (p.id == name or p.name == name):
            return "A profile named '%s' already exists." % name
    if except_id is None and (PROFILE_ROOT / name).exists():
        return "'%s' is already taken in %s." % (name, PROFILE_ROOT)
    return None


def next_account_name():
    n = 2
    while validate_name("Account %d" % n, None):
        n += 1
    return "Account %d" % n


# -------------------------------------------------------------------- running accounts --

def _processes():
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open("/proc/%s/cmdline" % d, "rb") as f:
                raw = f.read()
        except OSError:
            continue
        argv = [a.decode("utf-8", "replace") for a in raw.split(b"\0")]
        if argv and argv[-1] == "":
            argv.pop()
        if argv:
            yield int(d), argv


def _norm(path):
    return os.path.normpath(os.path.realpath(path))


def running_map(ids):
    """Account id to the process id of its main Claude process. Electron's helpers carry
    --type=... and the same --user-data-dir, so they are skipped; so is anything whose
    program name is not Claude's when it runs without a folder (the original account)."""
    by_dir = {_norm(str(profile_dir(i))): i for i in ids if i != DEFAULT_ID}
    app = find_claude()
    names = set(PROCESS_NAMES)
    if app:
        names.add(os.path.basename(app))
        names.add(os.path.basename(os.path.realpath(app)))
    me = {os.getpid(), os.getppid()}
    found = {}
    for pid, argv in _processes():
        if pid in me or any(a.startswith("--type=") for a in argv):
            continue
        dirs = [a[len("--user-data-dir="):] for a in argv if a.startswith("--user-data-dir=")]
        if dirs:
            hit = by_dir.get(_norm(dirs[-1]))
            if not hit and _norm(dirs[-1]) == _norm(str(DEFAULT_DATA)):
                hit = DEFAULT_ID
        else:
            exe = os.path.basename(argv[0])
            try:
                real = os.path.basename(os.readlink("/proc/%d/exe" % pid))
            except OSError:
                real = ""
            hit = DEFAULT_ID if (exe in names or real in names) and "crashpad" not in exe else None
        if hit and (hit not in found or pid < found[hit]):
            found[hit] = pid
    return found


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    try:
        with open("/proc/%d/stat" % pid) as f:
            return f.read().split(") ")[-1][:1] != "Z"
    except OSError:
        return False


# ------------------------------------------------------------------------------ launcher --

def split_args(s):
    out, cur, quote, anything = [], "", None, False
    for ch in s:
        if quote:
            if ch == quote:
                quote = None
            else:
                cur += ch
        elif ch in "\"'":
            quote, anything = ch, True
        elif ch in " \t\r\n":
            if anything or cur:
                out.append(cur)
                cur, anything = "", False
        else:
            cur += ch
            anything = True
    if anything or cur:
        out.append(cur)
    return out


def extra_args(pid_):
    v = Settings.map("ProfileArgs").get(pid_)
    if isinstance(v, list):
        return [str(a) for a in v]
    if isinstance(v, str):
        return split_args(v)
    return []


ENV_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def profile_env(pid_):
    m = Settings.map("ProfileEnv").get(pid_)
    if not isinstance(m, dict):
        return {}
    return {k: str(v) for k, v in m.items() if ENV_NAME.match(k)}


def launch_command(app, profile, trailing=()):
    cmd = [app]
    if not profile.is_default:
        cmd += ["--user-data-dir=%s" % profile.data_dir, "--class=%s" % profile.wm_class]
    return cmd + extra_args(profile.id) + list(trailing)


def spawn(cmd, env_extra=None):
    env = dict(os.environ)
    env.update(env_extra or {})
    # Our test and override variables are for the switcher, not for Claude.
    for k in ("CLAUDE_SWITCHER_APP", "CLAUDE_SWITCHER_SUPPORT_DIR", "CLAUDE_SWITCHER_RELEASE_DIR", "CLAUDE_SWITCHER_NO_FOCUS"):
        if k not in (env_extra or {}):
            env.pop(k, None)
    return subprocess.Popen(cmd, env=env, cwd=str(HOME), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True)


def focus(profile):
    """Brings an open account forward: by its window class when wmctrl is installed,
    otherwise by starting it again, which Electron's single-instance lock turns into
    focusing the copy already using that folder."""
    if profile.wm_class and shutil.which("wmctrl") and not os.environ.get("CLAUDE_SWITCHER_NO_FOCUS"):
        if subprocess.run(["wmctrl", "-x", "-a", profile.wm_class], capture_output=True).returncode == 0:
            return
    app = require_claude()
    spawn(launch_command(app, profile), profile_env(profile.id))


def start(profile):
    """Returns "focused" when the account was already open, "started" otherwise."""
    if profile.pid:
        focus(profile)
        return "focused"
    app = require_claude()
    if not profile.is_default:
        profile.data_dir.mkdir(parents=True, exist_ok=True)
        if Router.is_on() and Router.signed_in(profile.data_dir) is not True:
            Router.set_pending(profile.id)
    spawn(launch_command(app, profile), profile_env(profile.id))
    if Router.is_on():
        Router.hold_handler()
    return "started"


def wait_gone(pid, seconds):
    end = time.time() + seconds
    while time.time() < end:
        if not pid_alive(pid):
            return True
        time.sleep(0.2)
    return not pid_alive(pid)


def stop(profile, grace=8):
    if not profile.pid:
        return False
    pid = profile.pid
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return True
    if wait_gone(pid, grace):
        return True
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return True
    if wait_gone(pid, 4):
        return True
    raise SwitcherError("Could not quit '%s' (process %d)." % (profile.name, pid))


def restart(profile):
    if profile.pid:
        stop(profile)
        time.sleep(0.5)
        profile = resolve(profile.id) or profile
    start(profile)


# ------------------------------------------------------------------------------ accounts --

def add_account():
    name = next_account_name()
    d = PROFILE_ROOT / name
    d.mkdir(parents=True, exist_ok=True)
    p = Profile(name, name, d)
    start(p)
    Launchers.refresh()
    return p


def rename_account(p, raw):
    name = raw.strip()
    err = validate_name(name, p.id)
    if err:
        raise SwitcherError(err)
    Settings.set_entry("Labels", p.id, None if name == p.id else name)
    Launchers.refresh()


def delete_account(p):
    if p.is_default:
        raise SwitcherError("The Default profile is your original Claude and cannot be deleted here.")
    d = Path(os.path.normpath(str(p.data_dir)))
    # Never anything but a direct child of our own folder.
    if d.parent != Path(os.path.normpath(str(PROFILE_ROOT))) or p.id.startswith(".") or "/" in p.id:
        raise SwitcherError("Refusing to delete %s." % d)
    if p.pid:
        stop(p)
    if d.exists():
        shutil.rmtree(d)
    for key in ("Labels", "Colors", "ChosenColors", "ProfileArgs", "ProfileEnv"):
        Settings.set_entry(key, p.id, None)
    Launchers.remove_one(p.id)


# --------------------------------------------------------------------------------- colours --

PALETTE = [(66, 133, 180), (76, 150, 96), (150, 96, 180), (190, 80, 110),
           (60, 150, 150), (90, 110, 200), (200, 150, 50), (80, 86, 100)]


def colour_index(pid_):
    chosen = Settings.map("ChosenColors").get(pid_)
    if isinstance(chosen, int):
        return chosen % len(PALETTE)
    assigned = {k: v for k, v in Settings.map("Colors").items() if isinstance(v, int)}
    if pid_ in assigned:
        return assigned[pid_] % len(PALETTE)
    alive = set(profile_ids())
    use = [0] * len(PALETTE)
    for k, v in assigned.items():
        if k in alive:
            use[v % len(PALETTE)] += 1
    pick = use.index(min(use))
    assigned[pid_] = pick
    Settings.set("Colors", assigned)
    return pick


def hex_colour(i):
    return "#%02x%02x%02x" % PALETTE[i % len(PALETTE)]


def letter(name):
    for c in name:
        if c.isalnum():
            return c.upper()
    return name[:1].upper()


def badge_svg(fill, text):
    esc = text.replace("&", "&amp;").replace("<", "&lt;")
    return ('<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 256 256">'
            '<circle cx="128" cy="128" r="118" fill="%s"/>'
            '<text x="128" y="128" dy=".35em" text-anchor="middle" font-family="sans-serif" '
            'font-weight="bold" font-size="132" fill="#ffffff">%s</text></svg>\n' % (fill, esc))


APP_ICON_SVG = ('<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 256 256">'
                '<rect x="12" y="12" width="232" height="232" rx="52" fill="#2b2d33"/>'
                '<circle cx="104" cy="112" r="58" fill="#4285b4"/>'
                '<circle cx="152" cy="146" r="58" fill="#4c9660" stroke="#2b2d33" stroke-width="8"/></svg>\n')


# ------------------------------------------------------------------ app menu launchers --

def desktop_quote(arg):
    if re.match(r"^[A-Za-z0-9_./=:+-]+$", arg):
        return arg
    return '"' + re.sub(r'(["`$\\])', r"\\\1", arg) + '"'


def desktop_exec(args):
    # A literal % must be doubled in Exec.
    return " ".join(desktop_quote(a) for a in args).replace("%", "%%")


class Launchers:
    """Each account in the app menu with its own coloured icon, and the switcher's own
    entry listing them as quick actions (right-click it in the dock)."""

    @staticmethod
    def installed():
        return MAIN_DESKTOP.exists()

    @staticmethod
    def account_file(pid_):
        return APPS_DIR / ("claude-profile-%s.desktop" % slug(pid_))

    @staticmethod
    def icon_name(pid_):
        return "claude-profile-" + slug(pid_)

    @staticmethod
    def write_all():
        APPS_DIR.mkdir(parents=True, exist_ok=True)
        ICONS_DIR.mkdir(parents=True, exist_ok=True)
        (ICONS_DIR / "claude-profile-switcher.svg").write_text(APP_ICON_SVG, encoding="utf-8")
        me = switcher_command()
        profiles = list_profiles(False)
        actions = []
        for p in profiles:
            if not p.is_default:
                (ICONS_DIR / (Launchers.icon_name(p.id) + ".svg")).write_text(
                    badge_svg(hex_colour(colour_index(p.id)), letter(p.name)), encoding="utf-8")
                Launchers.account_file(p.id).write_text("\n".join([
                    "[Desktop Entry]", "Type=Application",
                    "Name=Claude (%s)" % p.name,
                    "Comment=Claude, signed in as your %s account" % p.name,
                    "Exec=%s" % desktop_exec([me, "--launch", p.id]),
                    "Icon=%s" % Launchers.icon_name(p.id),
                    "StartupWMClass=%s" % p.wm_class,
                    "Categories=Utility;", "Terminal=false",
                    "X-Claude-Profile-Switcher=%s" % VERSION, ""]), encoding="utf-8")
            actions.append(p)
        lines = ["[Desktop Entry]", "Type=Application", "Name=Claude Profile Switcher",
                 "GenericName=Claude account switcher",
                 "Comment=Run several Claude desktop accounts at once",
                 "Exec=%s" % desktop_exec([me]), "Icon=claude-profile-switcher",
                 "Categories=Utility;", "Keywords=Claude;Anthropic;account;profile;switch;",
                 "Terminal=false", "StartupNotify=true",
                 "Actions=%s" % "".join("open-%s;" % slug(p.id) for p in actions) + "add-account;", ""]
        for p in actions:
            lines += ["[Desktop Action open-%s]" % slug(p.id), "Name=Open %s" % p.name,
                      "Exec=%s" % desktop_exec([me, "--launch", p.id]), ""]
        lines += ["[Desktop Action add-account]", "Name=Add Account", "Exec=%s" % desktop_exec([me, "--add-account"]), ""]
        MAIN_DESKTOP.write_text("\n".join(lines), encoding="utf-8")
        # Files of accounts that are gone.
        keep = {Launchers.account_file(p.id).name for p in profiles if not p.is_default}
        for f in APPS_DIR.glob("claude-profile-*.desktop"):
            if f.name not in keep and f.name not in (MAIN_DESKTOP.name, ROUTER_DESKTOP.name):
                f.unlink()
        Launchers.update_caches()

    @staticmethod
    def update_caches():
        if shutil.which("update-desktop-database"):
            subprocess.run(["update-desktop-database", str(APPS_DIR)], capture_output=True)

    @staticmethod
    def refresh():
        if Launchers.installed():
            try:
                Launchers.write_all()
            except OSError:
                pass

    @staticmethod
    def remove_one(pid_):
        for f in (Launchers.account_file(pid_), ICONS_DIR / (Launchers.icon_name(pid_) + ".svg")):
            if f.exists():
                f.unlink()
        Launchers.refresh()

    @staticmethod
    def remove_all():
        removed = 0
        for f in list(APPS_DIR.glob("claude-profile-*.desktop")) + list(ICONS_DIR.glob("claude-profile-*.svg")):
            if f.name != ROUTER_DESKTOP.name:
                f.unlink()
                removed += 1
        Launchers.update_caches()
        return removed


# -------------------------------------------------------------------------- Code chats --

class Chat:
    def __init__(self, file, account, org, title, folder, updated):
        self.file, self.account, self.org = file, account, org
        self.title, self.folder, self.updated = title, folder, updated

    @property
    def id(self):
        return self.file.stem[len("local_"):]


class Chats:
    """The desktop app keeps one small JSON file per Claude Code chat, at
    <profile>/claude-code-sessions/<account id>/<organisation id>/local_<id>.json.
    Copying a chat means placing that file in another profile's store."""

    @staticmethod
    def _subdirs(p):
        try:
            return [d for d in p.iterdir() if d.is_dir()]
        except OSError:
            return []

    @staticmethod
    def root(profile):
        return profile.data_dir / "claude-code-sessions"

    @staticmethod
    def _first(obj, keys):
        for k in keys:
            v = obj.get(k) if isinstance(obj, dict) else None
            if isinstance(v, str) and v.strip():
                return v.strip()
        return None

    @staticmethod
    def list(profile):
        found = {}
        for account in Chats._subdirs(Chats.root(profile)):
            for org in Chats._subdirs(account):
                for f in org.glob("local_*.json"):
                    try:
                        obj = json.loads(f.read_text(encoding="utf-8"))
                    except (OSError, ValueError):
                        obj = {}
                    folder_path = Chats._first(obj, ["cwd", "workingDirectory", "projectPath", "folder", "path"]) or ""
                    folder = "" if not folder_path else ("(no folder)" if "/scratch-workspaces/" in folder_path else os.path.basename(folder_path.rstrip("/")))
                    updated = f.stat().st_mtime
                    title = Chats._first(obj, ["title", "name", "summary", "customTitle", "displayName"]) or "Chat %s" % f.stem[6:14]
                    seen = found.get(f.name)
                    if seen and seen.updated >= updated:
                        continue
                    found[f.name] = Chat(f, account.name, org.name, title, folder, updated)
        return sorted(found.values(), key=lambda c: -c.updated)

    @staticmethod
    def store(profile):
        orgs = [o for a in Chats._subdirs(Chats.root(profile)) for o in Chats._subdirs(a)]
        return max(orgs, key=lambda o: o.stat().st_mtime) if orgs else None

    @staticmethod
    def copy(chat, store):
        """True when copied, False when the target already has it. Only whole JSON string
        values equal to the source account or organisation id are swapped."""
        dest = store / chat.file.name
        if dest.exists():
            return False
        text = chat.file.read_text(encoding="utf-8")
        text = text.replace('"%s"' % chat.account, '"%s"' % store.parent.name).replace('"%s"' % chat.org, '"%s"' % store.name)
        dest.write_text(text, encoding="utf-8")
        return True

    @staticmethod
    def no_store_message(p):
        return ("'%s' has not used Claude Code yet, so there is nowhere to put the chats. Open it, sign in, "
                "visit the Code tab once, then try again." % p.name)


# ---------------------------------------------------------------------- sign-in links --

class Router:
    """A browser finishes a sign-in by opening a claude:// link, and the desktop gives it
    to whichever copy of Claude it starts, usually the original account. With routing on,
    the switcher is the claude:// handler instead and sends the link to the account that
    is waiting for it: started while signed out, else the only open account that is signed
    out, else the one whose window was used last, else Default. The link reaches that
    account by starting its Claude with the link, which Electron's single-instance lock
    hands to the copy already using that folder. Links are never written to a log."""

    PENDING = STATE_DIR / "pending-sign-in.json"
    BACKUP = STATE_DIR / "claude-handler-backup.txt"
    LOG = STATE_DIR / "router.log"
    SAFE = re.compile(r"^claude://[A-Za-z0-9._~:/?#\[\]@!$&'()*+,;=%-]*\Z")
    SIGN_IN = re.compile(r"^claude://(login/|claude\.ai/sso-callback([/?#]|\Z))")
    MIME = "x-scheme-handler/claude"

    @staticmethod
    def is_on():
        return Settings.get("SignInRouting") is True

    @staticmethod
    def log(msg):
        append_line(Router.LOG, msg)

    @staticmethod
    def is_safe(link):
        return isinstance(link, str) and len(link) <= 2048 and bool(Router.SAFE.match(link))

    @staticmethod
    def is_sign_in(link):
        return bool(Router.SIGN_IN.match(link))

    @staticmethod
    def signed_in(data_dir):
        try:
            obj = json.loads((Path(data_dir) / "config.json").read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return None
        if not isinstance(obj, dict):
            return None
        if "windowSizeWasSignedIn" in obj:
            return obj["windowSizeWasSignedIn"] is True
        if "oauth:tokenCacheV2" in obj:
            return len(str(obj["oauth:tokenCacheV2"])) > 100
        return False

    @staticmethod
    def set_pending(pid_, minutes=15):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        Router.PENDING.write_text(json.dumps({"Profile": pid_, "Expires": time.time() + minutes * 60}), encoding="utf-8")

    @staticmethod
    def clear_pending():
        try:
            Router.PENDING.unlink()
        except OSError:
            pass

    @staticmethod
    def pending():
        if not Router.PENDING.exists():
            return None
        try:
            d = json.loads(Router.PENDING.read_text(encoding="utf-8"))
            if d["Expires"] > time.time():
                return str(d["Profile"])
        except (OSError, ValueError, KeyError, TypeError):
            pass
        Router.clear_pending()
        return None

    @staticmethod
    def select(profiles, signed, pending, front):
        if pending:
            for p in profiles:
                if p.id == pending and not p.is_default:
                    return p, "launched while signed out"
        open_ = [p for p in profiles if p.pid and not p.is_default]
        out = [p for p in open_ if signed.get(p.id) is False]
        if len(out) == 1:
            return out[0], "the only open account that is signed out"
        if front:
            for p in open_:
                if p.pid == front:
                    return p, "its window was used most recently"
        return None

    @staticmethod
    def frontmost(pids):
        """On X11, the topmost window owned by one of these processes (xprop needed). The
        browser is in front during a sign-in, so the stacking order is used, not focus."""
        if not pids or not shutil.which("xprop") or not os.environ.get("DISPLAY"):
            return None
        try:
            out = subprocess.run(["xprop", "-root", "_NET_CLIENT_LIST_STACKING"], capture_output=True, text=True, timeout=3).stdout
            for wid in reversed(re.findall(r"0x[0-9a-fA-F]+", out)):
                o = subprocess.run(["xprop", "-id", wid, "_NET_WM_PID"], capture_output=True, text=True, timeout=3).stdout
                m = re.search(r"= (\d+)", o)
                if m and int(m.group(1)) in pids:
                    return int(m.group(1))
        except (OSError, subprocess.SubprocessError):
            pass
        return None

    @staticmethod
    def other_link_target():
        pid_ = Settings.get("OpenLinksIn")
        if not isinstance(pid_, str) or pid_ == DEFAULT_ID:
            return None
        p = resolve(pid_)
        return None if (p is None or p.is_default) else p

    @staticmethod
    def deliver(link, target):
        app = require_claude()
        if not target.is_default:
            target.data_dir.mkdir(parents=True, exist_ok=True)
        spawn(launch_command(app, target, [link]), profile_env(target.id))
        return "handed to its Claude" if target.pid else "started it with the link"

    @staticmethod
    def handle(link):
        if not Router.is_safe(link):
            Router.log("Refused a claude:// link that failed validation.")
            return

        def to_default(note):
            try:
                how = Router.deliver(link, resolve(DEFAULT_ID))
                Router.log("%s (%s)" % (note, how))
            except Exception as e:  # losing the link would be worse than any error
                Router.log("Could not pass a link to Default: %s" % e)

        if not Router.is_on():
            to_default("Routing is off; passed a link to Default.")
            return
        try:
            if not Router.is_sign_in(link):
                other = Router.other_link_target()
                if not other:
                    to_default("Not a sign-in link; passed to Default.")
                    return
                try:
                    how = Router.deliver(link, other)
                    Router.log("Not a sign-in link; opened in '%s' (Open Other Links In, %s)." % (other.name, how))
                except Exception as e:
                    to_default("Could not open a link in '%s': %s. Passed to Default." % (other.name, e))
                return
            profiles = list_profiles()
            signed = {}
            for p in profiles:
                if p.pid and not p.is_default:
                    v = Router.signed_in(p.data_dir)
                    if v is not None:
                        signed[p.id] = v
            pick = Router.select(profiles, signed, Router.pending(), Router.frontmost([p.pid for p in profiles if p.pid]))
            if not pick:
                to_default("Sign-in sent to Default (no other account was waiting for one).")
            else:
                target, reason = pick
                try:
                    how = Router.deliver(link, target)
                    Router.log("Sign-in sent to '%s' (%s, %s)." % (target.name, reason, how))
                except Exception as e:
                    to_default("Routing failed: %s. Sign-in passed to Default." % e)
            Router.clear_pending()
        finally:
            Router.hold_handler()

    # The handler itself, in mimeapps.list.
    @staticmethod
    def _read_mimeapps():
        try:
            return MIMEAPPS.read_text(encoding="utf-8").splitlines()
        except OSError:
            return []

    @staticmethod
    def handler():
        section = None
        for line in Router._read_mimeapps():
            s = line.strip()
            if s.startswith("[") and s.endswith("]"):
                section = s
            elif section == "[Default Applications]" and s.startswith(Router.MIME + "="):
                return s.split("=", 1)[1].split(";")[0].strip() or None
        if shutil.which("xdg-mime"):
            try:
                out = subprocess.run(["xdg-mime", "query", "default", Router.MIME], capture_output=True, text=True, timeout=5).stdout.strip()
                return out or None
            except (OSError, subprocess.SubprocessError):
                pass
        return None

    @staticmethod
    def set_handler(desktop_name):
        """Writes the choice into the user's mimeapps.list (what xdg-mime does), keeping
        every other line as it was. None removes the entry."""
        lines = Router._read_mimeapps()
        out, section, done, saw_section = [], None, False, False
        for line in lines:
            s = line.strip()
            if s.startswith("[") and s.endswith("]"):
                if section == "[Default Applications]" and not done and desktop_name:
                    out.append("%s=%s" % (Router.MIME, desktop_name))
                    done = True
                section = s
                saw_section = saw_section or s == "[Default Applications]"
                out.append(line)
                continue
            if section == "[Default Applications]" and s.startswith(Router.MIME + "="):
                if desktop_name and not done:
                    out.append("%s=%s" % (Router.MIME, desktop_name))
                    done = True
                continue
            out.append(line)
        if desktop_name and not done:
            if section == "[Default Applications]":
                out.append("%s=%s" % (Router.MIME, desktop_name))
            else:
                if out and out[-1].strip():
                    out.append("")
                out += ["[Default Applications]", "%s=%s" % (Router.MIME, desktop_name)]
        MIMEAPPS.parent.mkdir(parents=True, exist_ok=True)
        MIMEAPPS.write_text("\n".join(out) + "\n", encoding="utf-8")

    @staticmethod
    def is_ours():
        return Router.handler() == ROUTER_DESKTOP.name

    @staticmethod
    def write_router_desktop():
        APPS_DIR.mkdir(parents=True, exist_ok=True)
        ROUTER_DESKTOP.write_text("\n".join([
            "[Desktop Entry]", "Type=Application", "Name=Claude Profile Router",
            "Comment=Sends each Claude sign-in to the account that asked for it",
            "Exec=%s --handle-link %%u" % desktop_exec([switcher_command()]),
            "MimeType=%s;" % Router.MIME, "NoDisplay=true", "Terminal=false", ""]), encoding="utf-8")
        Launchers.update_caches()

    @staticmethod
    def enable():
        previous = Router.handler()
        if previous and previous != ROUTER_DESKTOP.name:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            Router.BACKUP.write_text(previous, encoding="utf-8")
        Router.write_router_desktop()
        Settings.set("SignInRouting", True)
        Router.set_handler(ROUTER_DESKTOP.name)

    @staticmethod
    def disable():
        Settings.set("SignInRouting", None)
        Router.clear_pending()
        if Router.is_ours():
            try:
                previous = Router.BACKUP.read_text(encoding="utf-8").strip()
            except OSError:
                previous = ""
            Router.set_handler(previous or None)
        for f in (ROUTER_DESKTOP, Router.BACKUP):
            if f.exists():
                f.unlink()
        Launchers.update_caches()

    @staticmethod
    def retake():
        """Claude makes itself the handler again as it starts; take it back."""
        if Router.is_on() and not Router.is_ours():
            current = Router.handler()
            if current and current != ROUTER_DESKTOP.name:
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                Router.BACKUP.write_text(current, encoding="utf-8")
            if not ROUTER_DESKTOP.exists():
                Router.write_router_desktop()
            Router.set_handler(ROUTER_DESKTOP.name)
            Router.log("Took back the claude:// handler.")

    @staticmethod
    def hold_handler(seconds=20):
        """After a launch, watch the handler closely for a while: in a thread when the
        window is running, otherwise in a short-lived copy of the switcher."""
        if not Router.is_on():
            return
        if RUNNING_GUI:
            threading.Thread(target=Router.hold_loop, args=(seconds,), daemon=True).start()
            return
        try:
            subprocess.Popen([sys.executable, switcher_command(), "--hold-handler"], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            pass

    @staticmethod
    def hold_loop(seconds=20):
        end = time.time() + seconds
        while time.time() < end:
            try:
                Router.retake()
            except OSError:
                pass
            time.sleep(0.5)

    @staticmethod
    def status_text():
        other = Router.other_link_target()
        lines = ["Sign-in routing:  %s" % ("on" if Router.is_on() else "off"),
                 "claude:// links open in: %s" % (Router.handler() or "nothing set"),
                 "Other links:      open in '%s'" % (other.name if other else DEFAULT_ID)]
        pend = Router.pending()
        if pend:
            p = resolve(pend, status=False)
            if p:
                lines.append("Waiting for:      '%s' to sign in" % p.name)
        return "\n".join(lines)


