    except Exception:
        return False


def run_gui(snapshot=None, appearance=None, snapshot_edit=None):
    global RUNNING_GUI
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk, Gdk, GLib, Gio, Pango
    except Exception:
        print("The window needs GTK 3 for Python. On Ubuntu or Debian: sudo apt install python3-gi gir1.2-gtk-3.0\n"
              "Everything also works from the command line; see claude-switcher --help.", file=sys.stderr)
        return 1
    import cairo  # comes with python3-gi-cairo, which GTK's Python bindings pull in

    RUNNING_GUI = True
    if appearance:
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", appearance == "dark")

    def badge(fill_index, text, size):
        area = Gtk.DrawingArea()
        area.set_size_request(size, size)
        area.set_valign(Gtk.Align.CENTER)

        def draw(_w, cr):
            r, g, b = PALETTE[fill_index % len(PALETTE)]
            cr.set_source_rgb(r / 255, g / 255, b / 255)
            cr.arc(size / 2, size / 2, size / 2, 0, 6.2832)
            cr.fill()
            if text:
                cr.set_source_rgb(1, 1, 1)
                cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
                cr.set_font_size(size * 0.5)
                ext = cr.text_extents(text)
                cr.move_to(size / 2 - ext.width / 2 - ext.x_bearing, size / 2 - ext.height / 2 - ext.y_bearing)
                cr.show_text(text)
        area.connect("draw", draw)
        return area

    def message(parent, title, text, buttons=(("Close", Gtk.ResponseType.CLOSE),), kind=Gtk.MessageType.INFO):
        d = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=kind, buttons=Gtk.ButtonsType.NONE, text=title)
        if text:
            d.format_secondary_text(text)
        for label, resp in buttons:
            d.add_button(label, resp)
        r = d.run()
        d.destroy()
        return r

    def in_background(work, done=None):
        def run():
            try:
                result, err = work(), None
            except Exception as e:  # shown to the user, not raised
                result, err = None, e
            if done:
                GLib.idle_add(lambda: (done(result, err), False)[1])
        threading.Thread(target=run, daemon=True).start()

    class EditDialog(Gtk.Dialog):
        def __init__(self, parent, p):
            Gtk.Dialog.__init__(self, title="Edit '%s'" % p.name, transient_for=parent, modal=True)
            self.set_default_size(460, -1)
            self.add_button("Cancel", Gtk.ResponseType.CANCEL)
            save = self.add_button("Save", Gtk.ResponseType.OK)
            save.get_style_context().add_class("suggested-action")
            self.set_default_response(Gtk.ResponseType.OK)
            box = self.get_content_area()
            box.set_spacing(6)
            box.set_border_width(14)

            def label(text, small=False):
                l = Gtk.Label(label=text, xalign=0)
                l.set_line_wrap(True)
                if small:
                    l.get_style_context().add_class("dim-label")
                    l.set_markup("<small>%s</small>" % GLib.markup_escape_text(text))
                else:
                    l.set_markup("<b>%s</b>" % GLib.markup_escape_text(text))
                box.pack_start(l, False, False, 0)

            label("Name")
            self.name = Gtk.Entry(text=p.name, activates_default=True)
            box.pack_start(self.name, False, False, 0)
            label("Badge colour")
            row = Gtk.Box(spacing=6)
            self.colours = []
            current = -1 if p.is_default else colour_index(p.id)
            first = None
            for i in range(len(PALETTE)):
                b = Gtk.RadioButton.new_from_widget(first)
                first = first or b
                b.set_mode(False)
                b.add(badge(i, "", 18))
                b.set_active(i == current)
                b.set_sensitive(not p.is_default)
                self.colours.append(b)
                row.pack_start(b, False, False, 0)
            box.pack_start(row, False, False, 0)
            label("Environment variables, one per line as NAME=value")
            self.env = Gtk.TextView(monospace=True)
            self.env.get_buffer().set_text("\n".join("%s=%s" % kv for kv in sorted(profile_env(p.id).items())))
            scroll = Gtk.ScrolledWindow()
            scroll.set_min_content_height(80)
            scroll.set_shadow_type(Gtk.ShadowType.IN)
            scroll.add(self.env)
            box.pack_start(scroll, True, True, 0)
            label("Extra launch flags")
            raw = Settings.map("ProfileArgs").get(p.id)
            self.flags_text = raw if isinstance(raw, str) else " ".join(
                '"%s"' % a if " " in a else a for a in (raw or []) if isinstance(a, str))
            self.flags = Gtk.Entry(text=self.flags_text)
            box.pack_start(self.flags, False, False, 0)
            label("Variables and flags reach Claude the next time this account starts.", small=True)
            self.show_all()

        def picked_colour(self):
            for i, b in enumerate(self.colours):
                if b.get_active():
                    return i
            return -1

        def env_text(self):
            buf = self.env.get_buffer()
            return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)

    class Window(Gtk.ApplicationWindow):
        def __init__(self, app):
            Gtk.ApplicationWindow.__init__(self, application=app, title="Claude Profile Switcher")
            self.set_default_size(620, 420)
            self.set_icon_name("claude-profile-switcher")
            self.signature = None
            self.available_update = None

            header = Gtk.HeaderBar(show_close_button=True, title="Claude Profile Switcher")
            self.set_titlebar(header)
            self.header = header
            add = Gtk.Button(label="Add Account")
            add.get_style_context().add_class("suggested-action")
            add.connect("clicked", lambda _b: self.add_account())
            header.pack_start(add)
            menu_button = Gtk.MenuButton()
            menu_button.add(Gtk.Image.new_from_icon_name("open-menu-symbolic", Gtk.IconSize.BUTTON))
            self.app_menu = Gtk.Menu()
            menu_button.set_popup(self.app_menu)
            self.app_menu.connect("show", lambda _m: self.fill_app_menu())
            header.pack_end(menu_button)

            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.add(outer)
            self.listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            scroll = Gtk.ScrolledWindow(vexpand=True)
            scroll.add(self.listbox)
            outer.pack_start(scroll, True, True, 0)
            self.status = Gtk.Label(xalign=0)
            self.status.set_ellipsize(Pango.EllipsizeMode.END)
            self.status.get_style_context().add_class("dim-label")
            self.status.set_margin_start(12)
            self.status.set_margin_end(12)
            self.status.set_margin_top(6)
            self.status.set_margin_bottom(8)
            outer.pack_start(self.status, False, False, 0)
            self.refresh(force=True)
            GLib.timeout_add_seconds(2, self.tick)
            GLib.timeout_add_seconds(5, self.upkeep)

        def report(self, text):
            self.status.set_text(text)

        def tick(self):
            self.refresh()
            return True

        def upkeep(self):
            def work():
                Router.retake()
                if Updater.is_due():
                    return Updater.check()
                return self.available_update
            in_background(work, lambda v, _e: setattr(self, "available_update", v))
            return True

        def refresh(self, force=False):
            profiles = list_profiles()
            sig = [(p.id, p.name, p.pid, colour_index(p.id)) for p in profiles]
            if not force and sig == self.signature:
                return
            self.signature = sig
            self.profiles = profiles
            for child in self.listbox.get_children():
                self.listbox.remove(child)
            for p in profiles:
                self.listbox.add(self.row(p))
            self.listbox.show_all()
            open_count = sum(1 for p in profiles if p.pid)
            self.header.set_subtitle("%d accounts · %d open" % (len(profiles), open_count))
            if not self.status.get_text():
                self.report("Each account keeps its own sign-in, chats and settings.")

        def row(self, p):
            row = Gtk.ListBoxRow(activatable=False)
            box = Gtk.Box(spacing=12, margin=10)
            row.add(box)
            box.pack_start(badge(colour_index(p.id), letter(p.name), 36), False, False, 0)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.CENTER)
            title = Gtk.Label(xalign=0)
            title.set_markup("<b>%s</b>" % GLib.markup_escape_text(p.name))
            detail = "Open" if p.pid else "Not open"
            if p.is_default:
                detail += "  ·  your original"
            elif p.name != p.id:
                detail += "  ·  folder: %s" % p.id
            sub = Gtk.Label(label=detail, xalign=0)
            sub.get_style_context().add_class("dim-label")
            text.pack_start(title, False, False, 0)
            text.pack_start(sub, False, False, 0)
            box.pack_start(text, True, True, 0)
            primary = Gtk.Button(label="Switch to" if p.pid else "Open", valign=Gtk.Align.CENTER)
            primary.connect("clicked", lambda _b: self.open(p.id))
            box.pack_start(primary, False, False, 0)
            quit_ = Gtk.Button(label="Quit", valign=Gtk.Align.CENTER, sensitive=bool(p.pid))
            quit_.connect("clicked", lambda _b: self.quit_account(p.id))
            box.pack_start(quit_, False, False, 0)
            more = Gtk.MenuButton(valign=Gtk.Align.CENTER)
            more.add(Gtk.Image.new_from_icon_name("view-more-symbolic", Gtk.IconSize.BUTTON))
            menu = Gtk.Menu()
            items = [("Edit...", lambda: self.edit(p.id)), ("Restart", lambda: self.restart(p.id)),
                     ("Transfer Code Chats...", lambda: self.transfer(p.id)),
                     ("Open Folder", lambda: subprocess.Popen(["xdg-open", str(p.data_dir)], start_new_session=True))]
            if not p.is_default:
                items += [None, ("Delete...", lambda: self.delete(p.id))]
            for it in items:
                if it is None:
                    menu.append(Gtk.SeparatorMenuItem())
                    continue
                mi = Gtk.MenuItem(label=it[0])
                mi.connect("activate", lambda _m, f=it[1]: f())
                menu.append(mi)
            menu.show_all()
            more.set_popup(menu)
            box.pack_start(more, False, False, 0)
            return row

        def fill_app_menu(self):
            for c in self.app_menu.get_children():
                self.app_menu.remove(c)
            if self.available_update:
                up = Gtk.MenuItem(label="Update to %s" % self.available_update)
                up.connect("activate", lambda _m: self.update())
                self.app_menu.append(up)
                self.app_menu.append(Gtk.SeparatorMenuItem())
            route = Gtk.CheckMenuItem(label="Send Sign-ins to the Right Account", active=Router.is_on())
            route.connect("toggled", lambda m: self.toggle_routing(m.get_active()))
            self.app_menu.append(route)
            launchers = Gtk.CheckMenuItem(label="Show Accounts in the App Menu", active=Launchers.installed())
            launchers.connect("toggled", lambda m: self.toggle_launchers(m.get_active()))
            self.app_menu.append(launchers)
            self.app_menu.append(Gtk.SeparatorMenuItem())
            check = Gtk.MenuItem(label="Check for Updates...")
            check.connect("activate", lambda _m: self.update())
            self.app_menu.append(check)
            about = Gtk.MenuItem(label="About")
            about.connect("activate", lambda _m: message(self, "Claude Profile Switcher %s" % VERSION,
                                                         "Runs several Claude desktop accounts at once.\n"
                                                         "Unofficial; not affiliated with Anthropic. MIT License.\n"
                                                         "https://github.com/%s" % REPO))
            self.app_menu.append(about)
            self.app_menu.show_all()

        def find(self, pid_):
            return resolve(pid_)

        def open(self, pid_):
            p = self.find(pid_)
            if not p:
                return
            try:
                how = start(p)
                self.report(("Switched to '%s'." if how == "focused" else "Opening '%s'...") % p.name)
            except Exception as e:
                message(self, "Could not open '%s'" % p.name, str(e), kind=Gtk.MessageType.ERROR)
            GLib.timeout_add(1500, lambda: (self.refresh(), False)[1])

        def add_account(self):
            try:
                p = add_account()
                self.report("Added '%s'. Sign in with the other account in the Claude window that just opened." % p.name)
            except Exception as e:
                message(self, "Could not add an account", str(e), kind=Gtk.MessageType.ERROR)
            GLib.timeout_add(1500, lambda: (self.refresh(force=True), False)[1])

        def quit_account(self, pid_):
            p = self.find(pid_)
            if not p:
                return
            self.report("Quitting '%s'..." % p.name)
            in_background(lambda: stop(p), lambda _r, e: (self.report(str(e) if e else "Quit '%s'." % p.name), self.refresh()))

        def restart(self, pid_):
            p = self.find(pid_)
            if not p:
                return
            self.report("Restarting '%s'..." % p.name)
            in_background(lambda: restart(p), lambda _r, e: (self.report(str(e) if e else "Restarted '%s'." % p.name), self.refresh()))

        def delete(self, pid_):
            p = self.find(pid_)
            if not p:
                return
            r = message(self, "Delete '%s'?" % p.name,
                        "Its sign-in, chats and settings in %s are removed. This cannot be undone." % p.data_dir,
                        (("Cancel", Gtk.ResponseType.CANCEL), ("Delete", Gtk.ResponseType.OK)), Gtk.MessageType.WARNING)
            if r != Gtk.ResponseType.OK:
                return
            in_background(lambda: delete_account(p), lambda _r, e: (self.report(str(e) if e else "Deleted '%s'." % p.name), self.refresh(force=True)))

        def edit(self, pid_):
            p = self.find(pid_)
            if not p:
                return
            d = EditDialog(self, p)
            resp = d.run()
            values = (d.name.get_text().strip(), d.picked_colour(), d.env_text(), d.flags.get_text().strip(), d.flags_text)
            d.destroy()
            if resp != Gtk.ResponseType.OK:
                return
            new_name, colour, env_text, flags, old_flags = values
            renaming = new_name and new_name != p.name
            if renaming:
                err = validate_name(new_name, p.id)
                if err:
                    message(self, "Could not save", err + " Nothing was saved.", kind=Gtk.MessageType.ERROR)
                    return
            env, bad = parse_env(env_text)
            if bad:
                message(self, "Some lines were left out", "These are not NAME=value:\n\n" + "\n".join(bad), kind=Gtk.MessageType.WARNING)
            old_env = profile_env(p.id)
            Settings.set_entry("ProfileEnv", p.id, env or None)
            if flags != old_flags:
                Settings.set_entry("ProfileArgs", p.id, flags or None)
            if not p.is_default and colour >= 0 and colour != colour_index(p.id):
                Settings.set_entry("ChosenColors", p.id, colour)
            if renaming:
                rename_account(p, new_name)
            else:
                Launchers.refresh()
            self.refresh(force=True)
            self.report("Saved '%s'." % (new_name if renaming else p.name))
            if p.pid and (env != old_env or flags != old_flags):
                r = message(self, "Restart '%s' to apply?" % (new_name if renaming else p.name),
                            "It is open, and its new variables or flags apply when it starts again.",
                            (("Later", Gtk.ResponseType.CANCEL), ("Restart", Gtk.ResponseType.OK)), Gtk.MessageType.QUESTION)
                if r == Gtk.ResponseType.OK:
                    self.restart(p.id)

        def transfer(self, pid_):
            src = self.find(pid_)
            if not src:
                return
            chats = Chats.list(src)
            targets = [p for p in list_profiles(False) if p.id != src.id]
            if not chats:
                self.report("'%s' has no Claude Code chats to transfer." % src.name)
                return
            if not targets:
                self.report("Add a second account first, then transfer chats to it.")
                return
            d = Gtk.Dialog(title="Copy Claude Code chats from '%s'" % src.name, transient_for=self, modal=True)
            d.set_default_size(520, 380)
            d.add_button("Cancel", Gtk.ResponseType.CANCEL)
            ok = d.add_button("Copy Chats", Gtk.ResponseType.OK)
            ok.get_style_context().add_class("suggested-action")
            box = d.get_content_area()
            box.set_spacing(8)
            box.set_border_width(12)
            info = Gtk.Label(xalign=0, label="Each chat stays here too. Finish a chat in one account before continuing it in the other.")
            info.set_line_wrap(True)
            box.pack_start(info, False, False, 0)
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            checks = []
            for c in chats:
                when = datetime.fromtimestamp(c.updated).strftime("%d %b %Y %H:%M")
                cb = Gtk.CheckButton(label="%s   %s" % (c.title, "  ·  ".join(x for x in (c.folder, when) if x)))
                inner.pack_start(cb, False, False, 0)
                checks.append(cb)
            scroll = Gtk.ScrolledWindow(vexpand=True)
            scroll.set_shadow_type(Gtk.ShadowType.IN)
            scroll.add(inner)
            box.pack_start(scroll, True, True, 0)
            row = Gtk.Box(spacing=8)
            row.pack_start(Gtk.Label(label="Copy to"), False, False, 0)
            combo = Gtk.ComboBoxText()
            for t in targets:
                combo.append_text(t.name)
            combo.set_active(0)
            row.pack_start(combo, False, False, 0)
            box.pack_start(row, False, False, 0)
            d.show_all()
            resp = d.run()
            picked = [c for c, cb in zip(chats, checks) if cb.get_active()]
            target = targets[combo.get_active()]
            d.destroy()
            if resp != Gtk.ResponseType.OK or not picked:
                return
            store = Chats.store(target)
            if not store:
                message(self, "Not ready yet", Chats.no_store_message(target), kind=Gtk.MessageType.WARNING)
                return
            copied = sum(1 for c in picked if Chats.copy(c, store))
            msg = "Copied %d chat(s) to '%s'." % (copied, target.name)
            if copied < len(picked):
                msg += " %d were already there." % (len(picked) - copied)
            if resolve(target.id) and resolve(target.id).pid:
                msg += " Quit and reopen it to see them."
            self.report(msg)

        def toggle_routing(self, on):
            try:
                if on and not Router.is_on():
                    Router.enable()
                    self.report("Sign-ins now go to the account that asked for them.")
                elif not on and Router.is_on():
                    Router.disable()
                    self.report("Sign-in routing is off.")
            except Exception as e:
                message(self, "Could not change sign-in routing", str(e), kind=Gtk.MessageType.ERROR)

        def toggle_launchers(self, on):
            try:
                if on:
                    Launchers.write_all()
                    self.report("Each account is now in the app menu, with its own icon.")
                else:
                    Launchers.remove_all()
                    self.report("Removed the accounts from the app menu.")
            except Exception as e:
                message(self, "Could not change the app menu", str(e), kind=Gtk.MessageType.ERROR)

        def update(self):
            self.report("Looking for a newer switcher...")

            def done(v, e):
                if e:
                    r = message(self, "Could not update", "%s\n\nThe releases page has every version." % e,
                                (("Close", Gtk.ResponseType.CLOSE), ("Open Releases", Gtk.ResponseType.OK)), Gtk.MessageType.WARNING)
                    if r == Gtk.ResponseType.OK:
                        subprocess.Popen(["xdg-open", "https://github.com/%s/releases/latest" % REPO], start_new_session=True)
                    self.report("")
                elif v:
                    self.available_update = None
                    message(self, "Updated to %s" % v, "The switcher restarts to finish. Your accounts are not touched.")
                    os.execv(sys.executable, [sys.executable, switcher_command()])
                else:
                    self.available_update = None
                    self.report("Claude Profile Switcher %s is the newest release." % VERSION)
            in_background(Updater.install, done)

    def capture(widget_window, path):
        gdkwin = widget_window.get_window()
        w, h = gdkwin.get_width(), gdkwin.get_height()
        pix = Gdk.pixbuf_get_from_window(gdkwin, 0, 0, w, h)
        pix.savev(path, "png", [], [])

    app = Gtk.Application(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
    state = {"window": None}

    def activate(a):
        if state["window"] is None:
            state["window"] = Window(a)
        state["window"].show_all()
        state["window"].present()
        if snapshot or snapshot_edit:
            def shoot():
                win = state["window"]
                if snapshot_edit:
                    p = resolve_or_throw(snapshot_edit[1])
                    dlg = EditDialog(win, p)
                    dlg.show_all()
                    GLib.timeout_add(900, lambda: (capture(dlg, snapshot_edit[0]), a.quit(), False)[2])
                else:
                    capture(win, snapshot)
                    a.quit()
                return False
            GLib.timeout_add(1200, shoot)

    app.connect("activate", activate)
    if snapshot or snapshot_edit:
        # A one-off render: never hand over to (or become) the running window.
        app.set_flags(Gio.ApplicationFlags.NON_UNIQUE)
    return app.run([sys.argv[0]])


def parse_env(text):
    env, bad = {}, []
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        name, eq, value = line.partition("=")
        if not eq or not ENV_NAME.match(name.strip()):
            bad.append(line)
            continue
        env[name.strip()] = value
    return env, bad


# --------------------------------------------------------------------------- command line --

USAGE = """claude-switcher: run several Claude desktop accounts at once (Linux)

With no arguments it opens the window. Commands:
  --list                      Accounts, whether each is open, and their folders
  --add-account               Make a new account and open it to sign in
  --launch NAME               Open an account, or bring it forward if open
  --quit NAME                 Quit one account
  --restart NAME              Quit and reopen it
  --rename NAME NEW-NAME      Change its label (the folder stays)
  --delete NAME               Delete an account and its folder
  --edit NAME [--name NEW] [--color 0-7] [--flags "..."] [--env K=V ...] [--clear-env]
                              Change an account's name, colour, launch flags or variables
  --chats NAME                That account's Claude Code chats
  --transfer FROM TO [--all | --chat ID ...]
                              Copy Claude Code chats to another account
  --install-launchers         Put each account in the app menu with its own icon
  --remove-launchers          Take them out again
  --route-sign-ins            Send each browser sign-in to the account that asked for it
  --revert                    Give claude:// links back to Claude
  --open-links-in NAME        Where other claude:// links open while routing is on
  --open-link URL [--account NAME]
                              Open a claude:// link in one account
  --status                    Sign-in routing and the claude:// handler
  --check-update              Is there a newer switcher?
  --update                    Install it (checksum verified)
  --doctor                    What a bug report needs, user name redacted
  --uninstall [--remove-profiles]
                              Remove what the switcher made outside your accounts
  --claude-path PATH          Use this Claude (remembered)
  --version                   Print the version
"""


def build_parser():
    ap = argparse.ArgumentParser(prog="claude-switcher", usage=USAGE, add_help=False)
    a = ap.add_argument
    a("-h", "--help", action="store_true")
    a("--version", action="store_true")
    a("--list", action="store_true")
    a("--add-account", action="store_true")
    a("--launch")
    a("--quit")
    a("--restart")
    a("--rename", nargs=2)
    a("--delete")
    a("--edit")
    a("--name")
    a("--color", type=int)
    a("--flags")
    a("--env", action="append")
    a("--clear-env", action="store_true")
    a("--chats")
    a("--transfer", nargs=2)
    a("--all", action="store_true")
    a("--chat", action="append")
    a("--install-launchers", action="store_true")
    a("--remove-launchers", action="store_true")
    a("--route-sign-ins", action="store_true")
    a("--revert", action="store_true")
    a("--open-links-in")
    a("--open-link")
    a("--account")
    a("--status", action="store_true")
    a("--handle-link")
    a("--hold-handler", action="store_true")
    a("--check-update", action="store_true")
    a("--update", action="store_true")
    a("--doctor", action="store_true")
    a("--uninstall", action="store_true")
    a("--remove-profiles", action="store_true")
    a("--claude-path")
    a("--snapshot")
    a("--snapshot-edit")
    a("--appearance", choices=["light", "dark"])
    return ap


def main(argv):
    ap = build_parser()

    def bad_usage(msg):
        raise SwitcherError("%s\n\n%s" % (msg, USAGE))
    ap.error = bad_usage
    o = ap.parse_args(argv)

    if o.help:
        print(USAGE)
        return 0
    if o.version:
        print(VERSION)
        return 0
    if o.claude_path:
        if not os.access(o.claude_path, os.X_OK):
            raise SwitcherError("%s is not an executable file." % o.claude_path)
        Settings.set("ClaudePath", os.path.abspath(o.claude_path))
        print("Using %s." % os.path.abspath(o.claude_path))
        if not any([o.list, o.launch, o.add_account]):
            return 0
    if o.handle_link is not None:
        Router.handle(o.handle_link)
        return 0
    if o.hold_handler:
        Router.hold_loop(20)
        return 0
    if o.list:
        print(list_text())
        return 0
    if o.doctor:
        print(doctor())
        return 0
    if o.uninstall:
        for line in uninstall(o.remove_profiles):
            print("- " + line)
        return 0
    if o.add_account:
        p = add_account()
        print("Added '%s'. Sign in with the other account in the Claude window that just opened." % p.name)
        return 0
    if o.launch:
        p = resolve_or_throw(o.launch)
        how = start(p)
        print(("Switched to '%s'." if how == "focused" else "Opened '%s'.") % p.name)
        return 0
    if o.quit:
        p = resolve_or_throw(o.quit)
        print(("Quit '%s'." if stop(p) else "'%s' was not open.") % p.name)
        return 0
    if o.restart:
        p = resolve_or_throw(o.restart)
        restart(p)
        print("Restarted '%s'." % p.name)
        return 0
    if o.rename:
        p = resolve_or_throw(o.rename[0])
        rename_account(p, o.rename[1])
        print("Renamed '%s' to '%s'." % (p.name, o.rename[1].strip()))
        return 0
    if o.delete:
        p = resolve_or_throw(o.delete)
        delete_account(p)
        print("Deleted '%s'." % p.name)
        return 0
    if o.edit:
        p = resolve_or_throw(o.edit)
        if o.name:
            err = validate_name(o.name, p.id)
            if err:
                raise SwitcherError(err + " Nothing was saved.")
        if o.color is not None:
            if p.is_default:
                raise SwitcherError("The Default profile keeps Claude's own icon.")
            Settings.set_entry("ChosenColors", p.id, o.color % len(PALETTE))
        if o.flags is not None:
            Settings.set_entry("ProfileArgs", p.id, o.flags.strip() or None)
        if o.clear_env or o.env:
            env = {} if o.clear_env else profile_env(p.id)
            more, bad = parse_env("\n".join(o.env or []))
            if bad:
                raise SwitcherError("Not NAME=value: %s" % ", ".join(bad))
            env.update(more)
            Settings.set_entry("ProfileEnv", p.id, env or None)
        if o.name:
            rename_account(p, o.name)
        else:
            Launchers.refresh()
        print("Saved '%s'.%s" % (o.name or p.name, " Restart it to apply the new flags or variables." if p.pid and (o.flags is not None or o.env or o.clear_env) else ""))
        return 0
    if o.chats:
        p = resolve_or_throw(o.chats)
        for c in Chats.list(p):
            print("%s  %s  %s  %s" % (c.id, datetime.fromtimestamp(c.updated, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), c.folder or "-", c.title))
        return 0
    if o.transfer:
        src, dst = resolve_or_throw(o.transfer[0]), resolve_or_throw(o.transfer[1])
        if src.id == dst.id:
            raise SwitcherError("Pick two different accounts.")
        wanted = o.chat or []
        chats = [c for c in Chats.list(src) if o.all or c.id in wanted or c.file.name in wanted]
        if not chats:
            raise SwitcherError("No chats picked. Use --all, or --chat with ids from --chats \"%s\"." % src.name)
        store = Chats.store(dst)
        if not store:
            raise SwitcherError(Chats.no_store_message(dst))
        copied = sum(1 for c in chats if Chats.copy(c, store))
        skipped = len(chats) - copied
        print("Copied %d chat(s) to '%s'.%s" % (copied, dst.name, " %d were already there." % skipped if skipped else ""))
        return 0
    if o.install_launchers:
        Launchers.write_all()
        print("Each account is in the app menu now, with its own icon, and the switcher's entry lists them "
              "(right-click it in the dock). Files: %s" % APPS_DIR)
        return 0
    if o.remove_launchers:
        print("Removed %d file(s)." % Launchers.remove_all())
        return 0
    if o.route_sign_ins:
        Router.enable()
        print("Sign-ins now go to the account that asked for them. claude:// links open in: %s." % Router.handler())
        return 0
    if o.revert:
        Router.disable()
        print("Sign-in routing is off. claude:// links open in: %s." % (Router.handler() or "the system default"))
        return 0
    if o.status:
        print(Router.status_text())
        return 0
    if o.open_links_in:
        if o.open_links_in == DEFAULT_ID:
            Settings.set("OpenLinksIn", None)
            print("Other links open in 'Default'.")
            return 0
        p = resolve_or_throw(o.open_links_in)
        Settings.set("OpenLinksIn", None if p.is_default else p.id)
        print("Other links open in '%s'." % p.name)
        return 0
    if o.open_link:
        if not Router.is_safe(o.open_link):
            raise SwitcherError("That is not a claude:// link.")
        target = resolve_or_throw(o.account) if o.account else (Router.other_link_target() or resolve_or_throw(DEFAULT_ID))
        how = Router.deliver(o.open_link, target)
        print("Opened the link in '%s' (%s)." % (target.name, how))
        return 0
    if o.check_update:
        v = Updater.check()
        print("Version %s is available (this is %s). Install it with --update." % (v, VERSION) if v
              else "Claude Profile Switcher %s is up to date." % VERSION)
        return 0
    if o.update:
        v = Updater.install()
        print("Updated to %s." % v if v else "Claude Profile Switcher %s is up to date." % VERSION)
        return 0
    if o.snapshot or o.snapshot_edit:
        edit = (o.snapshot_edit, o.account) if o.snapshot_edit else None
        if edit and not o.account:
            raise SwitcherError("--snapshot-edit needs --account NAME.")
        return run_gui(snapshot=o.snapshot, appearance=o.appearance, snapshot_edit=edit)
    if argv:
        raise SwitcherError("Unknown arguments: %s\n\n%s" % (" ".join(argv), USAGE))
    return run_gui()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SwitcherError as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
