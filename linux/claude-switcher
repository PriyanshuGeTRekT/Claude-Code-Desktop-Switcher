def redact(text):
    user = os.environ.get("USER") or Path.home().name
    if not user:
        return text
    return re.sub(re.escape(user), "<user>", text, flags=re.I)


def doctor():
    app = find_claude()
    out = ["Claude Profile Switcher %s (Linux)" % VERSION]
    try:
        with open("/etc/os-release") as f:
            pretty = re.search(r'^PRETTY_NAME="?([^"\n]+)', f.read(), re.M)
        out.append(pretty.group(1) if pretty else "Linux")
    except OSError:
        out.append("Linux")
    out.append("Session: %s, desktop %s" % (os.environ.get("XDG_SESSION_TYPE", "unknown"), os.environ.get("XDG_CURRENT_DESKTOP", "unknown")))
    out.append("Claude: %s at %s" % (claude_version(app), app) if app else "Claude: NOT FOUND")
    out.append("Switcher: %s" % switcher_command())
    out.append("Accounts folder: %s" % PROFILE_ROOT)
    out.append("App menu launchers: %s" % ("installed" if Launchers.installed() else "not installed"))
    out.append(Router.status_text())
    out.append("Update check: %s" % ("off" if Settings.get("UpdateCheck") is False else "daily"))
    out.append("Window: %s" % ("GTK 3 available" if gtk_available() else "GTK 3 for Python missing (python3-gi)"))
    out.append("")
    out.append("Accounts:")
    for p in list_profiles():
        name = p.name if p.name == p.id else "%s [%s]" % (p.name, p.id)
        notes = ["original"] if p.is_default else []
        signed = None if p.is_default else Router.signed_in(p.data_dir)
        if signed is not None:
            notes.append("signed in" if signed else "signed out")
        out.append("  %-24s %-10s %s%s" % (name, "pid %d" % p.pid if p.pid else "not open", p.data_dir,
                                         "  (%s)" % ", ".join(notes) if notes else ""))
    out.append("")
    out.append("Router log, last lines:")
    try:
        tail = Router.LOG.read_text(encoding="utf-8").splitlines()[-5:]
    except OSError:
        tail = []
    out += ["  " + t for t in tail] or ["  (none)"]
    return redact("\n".join(out))


def uninstall(remove_profiles):
    done = []
    if Router.is_on() or Router.is_ours():
        Router.disable()
        done.append("gave claude:// links back to %s" % (Router.handler() or "the system default"))
    n = Launchers.remove_all()
    if n:
        done.append("removed %d app menu launcher file(s)" % n)
    if remove_profiles:
        for p in list_profiles():
            if not p.is_default:
                try:
                    delete_account(p)
                    done.append("deleted the account '%s' and its folder" % p.name)
                except Exception as e:
                    done.append("kept '%s': %s" % (p.name, e))
    if STATE_DIR.exists():
        shutil.rmtree(STATE_DIR, ignore_errors=True)
        done.append("removed %s" % STATE_DIR)
    if remove_profiles:
        if SETTINGS_FILE.exists():
            SETTINGS_FILE.unlink()
            done.append("removed %s" % SETTINGS_FILE)
        try:
            PROFILE_ROOT.rmdir()
            done.append("removed %s" % PROFILE_ROOT)
        except OSError:
            pass
    else:
        done.append("kept your accounts and %s; add --remove-profiles to delete them" % SETTINGS_FILE)
    me = switcher_command()
    if me.startswith("/usr/"):
        done.append("to finish, remove the package: sudo apt remove claude-profile-switcher")
    else:
        done.append("to finish, delete %s" % me)
    return done


def list_text():
    rows = []
    for p in list_profiles():
        name = p.name if p.name == p.id else "%s [%s]" % (p.name, p.id)
        state = "open (pid %d)" % p.pid if p.pid else "not open"
        rows.append("%-24s%-22s%s" % (name + " ", state, p.data_dir))
    return "\n".join(rows)


