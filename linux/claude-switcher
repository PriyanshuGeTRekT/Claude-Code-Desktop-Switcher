# ----------------------------------------------------------------- where things live --

def _env_path(name, fallback):
    v = os.environ.get(name, "")
    return Path(v) if v else fallback


HOME = Path.home()
CONFIG_HOME = _env_path("XDG_CONFIG_HOME", HOME / ".config")
DATA_HOME = _env_path("XDG_DATA_HOME", HOME / ".local" / "share")
# Where Claude keeps its own data, and where the extra accounts go beside it.
SUPPORT = _env_path("CLAUDE_SWITCHER_SUPPORT_DIR", CONFIG_HOME)
PROFILE_ROOT = SUPPORT / "ClaudeProfiles"
SETTINGS_FILE = PROFILE_ROOT / "settings.json"
DEFAULT_DATA = SUPPORT / "Claude"
STATE_DIR = PROFILE_ROOT / ".switcher"
APPS_DIR = DATA_HOME / "applications"
ICONS_DIR = DATA_HOME / "icons" / "hicolor" / "scalable" / "apps"
